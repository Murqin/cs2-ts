<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CounterStrikeSharp 1.0.373 targets net10.0 and ships its own .NET 10 runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cs2Ts.Plugin</AssemblyName>
    <RootNamespace>Cs2Ts.Plugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Shipped into the author's scripts directory on first run. They live at the
      repository root because the node tests compile the examples against exactly these
      files, so what an author gets and what CI checks cannot drift apart.
    -->
    <EmbeddedResource Include="../../templates/cs2ts.d.ts" LogicalName="cs2ts.d.ts" />
    <EmbeddedResource Include="../../templates/tsconfig.json" LogicalName="tsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Cs2Ts.Runtime/Cs2Ts.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by the host at runtime; do not ship a second copy into the plugin folder. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.373" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
