<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cs2Ts.Runtime/Cs2Ts.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whole scripts, run end to end rather than asserted on in pieces: stripping,
         dispatch, timers, reload and the command path all have to agree at once for
         one of these to work. They are read from disk at run time, so they are copied
         out rather than embedded. The node suite compiles the same files against
         the shipped tsconfig, which is what keeps them honest as script rather than as
         a string that happens to run. -->
    <None Include="fixtures/welcome.ts" Link="welcome.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/rounds.js" Link="rounds.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/timers.ts" Link="timers.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/entities.ts" Link="entities.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/hud.ts" Link="hud.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/menu.ts" Link="menu.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/targets.ts" Link="targets.ts" CopyToOutputDirectory="PreserveNewest" />

    <!-- A plugin that is a folder, copied as one: the suite loads it through discovery,
         so the folder has to be a folder on disk rather than two flattened files. -->
    <None Include="fixtures/jetpack/**" Link="jetpack/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>